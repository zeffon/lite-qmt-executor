# =============================================================================
# lite-qmt-executor 环境配置
# =============================================================================
# 复制此文件为 .env，填入真实值后启动：
#   cp .env.example .env
# =============================================================================

# -------------------- QMT 配置 --------------------
# 指向 miniQMT userdata_mini 目录
QMT_PATH=D:\国金证券QMT交易端\userdata_mini
# 资金账号
ACCOUNT_ID=888888
# 消息前缀（用于多账户区分）
BROKER_NAME=国金证券0525

# -------------------- HTTP 服务 --------------------
HTTP_HOST=0.0.0.0
HTTP_PORT=30015

# -------------------- WebSocket 信号网关 --------------------
# 三个都填了才启动 WebSocket 客户端，不需要则留空
GATEWAY_HOST=
GATEWAY_PORT=
GATEWAY_TOKEN=

# -------------------- 日志配置 --------------------
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_FILE=qmt_trading.log
LOG_BACKUP_DAYS=7
WAL_BACKUP_DAYS=7

# -------------------- 买入引擎 --------------------
# 买入总开关（设为 False 可临时屏蔽所有买入信号）
BUY_ENABLED=False